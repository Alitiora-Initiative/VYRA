# Public browser configuration (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Market-data providers
COINGECKO_DEMO_API_KEY=
TWELVEDATA_API_KEY=

# Deployment / runtime
NEXT_PUBLIC_APP_URL=http://localhost:3000
PAPER_DEFAULT_CURRENCY=USD
PAPER_INITIAL_CASH=100000
PAPER_MAX_ORDER_NOTIONAL=10000
PAPER_MAX_POSITION_NOTIONAL=25000
PAPER_SLIPPAGE_BPS=5

# Live broker credentials are intentionally not supported by this paper-only release.
