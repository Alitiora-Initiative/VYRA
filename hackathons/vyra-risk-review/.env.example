# Optional: leave all provider keys blank to run the offline scripted Mozaik demo.
# For live model inference, set one provider key. Never commit real API keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Mozaik routes the model based on this model name.
MOZAIK_MODEL=gpt-5.5
REVIEW_TIMEOUT_MS=180000
